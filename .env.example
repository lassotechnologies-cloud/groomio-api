# Groomio API environment variables.
# Copy to .env and fill in real values. NEVER commit real secrets.
#
# This file is the API repository's own copy of the deployment contract. The
# names here are read by `app.core.config.Settings` (Pydantic), which sets
# `env_prefix=""` — a field named `r2_account_id` is read from `R2_ACCOUNT_ID`
# and nothing else. `tests/test_env_template.py` fails if the two drift apart.
#
# The `groomio-infra` repository carries a superset template that additionally
# holds the frontend and Railway variables. CI checks this file against that
# one so the two cannot silently diverge.

# === Database ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/groomie
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
SECRET_KEY=change-me-64-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# === Africa's Talking (SMS OTP) ===
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=groomio
AT_SENDER_ID=GROOMIO

# === Email OTP (Gmail SMTP) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=lassotechnologies@gmail.com
EMAIL_PASS=
EMAIL_FROM=Groomio <lassotechnologies@gmail.com>
EMAIL_USE_TLS=true

# === OTP ===
OTP_TTL_MIN=10

# === M-Pesa (Safaricom Daraja) ===
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v2/query
MPESA_CALLBACK_URL=https://api.groomio.app/v1/payments/webhooks/daraja

# === Pesapal ===
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_MERCHANT_ID=your-merchant-id
PESAPAL_BASE_URL=https://sandbox.pesapal.com
PESAPAL_IPN_URL=https://api.groomio.app/v1/payments/webhooks/pesapal
PESAPAL_RETURN_URL=https://app.groomio.app/settings/billing?status=paid
PESAPAL_CANCEL_URL=https://app.groomio.app/settings/billing?status=cancelled

# === Cloudflare R2 ===
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=groomio
R2_SIGNED_URL_TTL_SECONDS=300

# === Web push ===
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@groomio.app

# === Observability ===
SENTRY_DSN=
METABASE_DATABASE_PASSWORD=

# === Pricing ===
DAILY_PRICE_KES=40
DISCOUNT_BIWEEKLY_PCT=11
DISCOUNT_MONTHLY_PCT=17
DISCOUNT_HALF_YEARLY_PCT=25
DISCOUNT_YEARLY_PCT=33

# === Trial / grace / reminders ===
TRIAL_DAYS=10
GRACE_DAYS=3
REMIND_TRIAL_DAYS=7,9,10
REMIND_BEFORE_RENEWAL_DAYS=3

# === Compliance ===
PRIVACY_POLICY_URL=https://groomio.app/privacy
TERMS_URL=https://groomio.app/terms
# Chat is archived, not deleted, after this — a customer disputing a booking
# needs the conversation to still exist.
CHAT_RETENTION_MONTHS=12
BACKUP_RETENTION_DAYS=30

# === App ===
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# === Tests (never set this in production) ===
# Enables the database-backed suite. tests/conftest.py refuses any URL whose
# database name does not look like a test database, so a mistyped value fails
# loudly rather than wiping live data. Left unset, those tests skip with a
# reason rather than passing silently.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/groomio_test